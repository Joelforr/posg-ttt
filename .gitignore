# .gitignore for the POSG tic-tac-toe monorepo.
#
# Committed intentionally (do NOT add here):
#   - all source under packages/ and bots/
#   - pnpm-lock.yaml, package.json, tsconfig files, vite.config.ts
#   - Dockerfile, .dockerignore, fly.toml
#   - requirements.txt (Python bots)
#   - documentation, guides, README
#   - .env.example templates (if you create any)

# ─── Dependencies ─────────────────────────────────────────────────────────────
# Never commit installed packages. Recreated by `pnpm install` (Node) or
# `pip install -r requirements.txt` (Python).
node_modules
.pnpm-store
bots/.venv
bots/venv
__pycache__
*.py[cod]
*$py.class

# ─── Build outputs ────────────────────────────────────────────────────────────
# Vite's dist/ for the client bundle, tsc's dist/ for server compile output.
# Regenerated by `pnpm build`.
dist
build
*.tsbuildinfo
.vite

# ─── Test & tooling caches ────────────────────────────────────────────────────
coverage
.nyc_output
.vitest-cache
.pytest_cache
.mypy_cache
.ruff_cache

# ─── Secrets & environment ────────────────────────────────────────────────────
# Never commit real env files. If you need to document required variables,
# commit .env.example (which is NOT matched by the patterns below).
.env
.env.local
.env.*.local
*.pem
*.key

# ─── Runtime artifacts ────────────────────────────────────────────────────────
# JSONL logs written by the server; local checkpoints from the bot guide.
# Remove the model .pkl lines if you want to ship a pre-trained baseline
# alongside the code.
*.jsonl
bots/qtable.pkl
bots/opp_model.pkl
data/

# ─── Fly.io ───────────────────────────────────────────────────────────────────
# Local Fly state cache. Note: fly.toml IS committed — it's the app config.
.fly

# ─── Editors ──────────────────────────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo
*~

# ─── OS metadata ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Wrong-package-manager lockfiles ──────────────────────────────────────────
# We use pnpm; commit only pnpm-lock.yaml. If someone accidentally runs
# `npm install` or `yarn`, don't let their lockfile land in the repo.
package-lock.json
yarn.lock

# ─── Misc scratch ─────────────────────────────────────────────────────────────
tmp
temp
.cache
